<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Extend" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/extend_background</item>
        <item name="android:statusBarColor">@color/extend_background</item>
        <item name="android:navigationBarColor">@color/extend_background</item>
    </style>

    <style name="Theme.Extend.Fullscreen" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Extend.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
