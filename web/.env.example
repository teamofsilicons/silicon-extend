# Bridge API base URL. Default in a production build: https://backend.bridge.teamofsilicons.com
# `same-origin` sends requests to /api/... on the website's own origin (dev proxy, or the Vercel rewrite).
# VITE_BRIDGE_API_URL=same-origin

# Silicon IAM's sign-in origin, only if it can't be derived from iam_base_url (backend.X → auth.X).
# VITE_IAM_LOGIN_URL=https://auth.iam.teamofsilicons.com

# Dev server only: where /api is proxied. Default http://127.0.0.1:8480 (the Rust service).
# BRIDGE_API_PROXY=http://127.0.0.1:8480
