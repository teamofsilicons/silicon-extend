{
  "name": "@teamofsilicons/extend-web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Silicon Extend configuration website (extend.teamofsilicons.com): pair devices and decide which Silicons can use them.",
  "scripts": {
    "docs:gen": "node scripts/gen-docs.mjs",
    "dev": "pnpm docs:gen && vite",
    "dev:mock": "pnpm docs:gen && concurrently -k -n mock,web -c blue,green \"tsx mock/server.ts\" \"EXTEND_API_PROXY=http://127.0.0.1:8490 vite --port 5190 --strictPort\"",
    "mock": "tsx mock/server.ts",
    "build": "pnpm docs:gen && node scripts/gen-licences.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm docs:gen && playwright test",
    "test:e2e:real": "pnpm docs:gen && playwright test -c playwright.real.config.ts",
    "test:e2e:compat": "node scripts/build-web-1.0.mjs && playwright test -c playwright.compat.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "lucide-solid": "1.48.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "concurrently": "10.0.5",
    "jsdom": "30.1.1",
    "marked": "18.0.14",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.2",
    "ws": "^8.21.3",
    "yaml": "2.9.1"
  }
}
