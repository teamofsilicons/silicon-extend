# Silicon Extend service. Every variable the service reads; see docs/deployment.md.
# These values point at the local Silicon Accounts stack; production uses https origins.

# Required everywhere: production, development or test (development and test allow local stand-ins).
EXTEND_ENVIRONMENT=development
EXTEND_DATABASE_URL=postgres://extend:extend@127.0.0.1:5440/extend
EXTEND_BIND=127.0.0.1:4221
EXTEND_PUBLIC_URL=http://127.0.0.1:4221
EXTEND_DATA_DIR=./data

# Silicon Accounts: the public origin is every access token's `iss`; the API origin is how this
# server reaches it (defaults to ACCOUNTS_URL). Plain http only for this machine.
ACCOUNTS_URL=http://localhost:9590
ACCOUNTS_API_URL=http://127.0.0.1:9589
# Extend's app in Silicon Apps (the app id defaults to extend).
EXTEND_APP_ID=extend
EXTEND_APP_SECRET=sa_app_extend_replace_me
# The signing secret of Extend's webhook in Silicon Accounts (POST /webhooks/accounts). Required in
# production. During a rotation, also set EXTEND_ACCOUNTS_WEBHOOK_PREVIOUS_SECRET.
EXTEND_ACCOUNTS_WEBHOOK_SECRET=whsec_replace_me
# Seals the Briefcase proof refresh tokens Extend keeps: 32 random bytes, unpadded base64url.
# Required in production. `openssl rand 32 | basenc --base64url | tr -d '='`
EXTEND_DELEGATION_ENCRYPTION_KEY=

# Files: briefcase (production) or local (development).
EXTEND_FILES_MODE=local
# EXTEND_BRIEFCASE_URL=https://backend.briefcase.teamofsilicons.com
# EXTEND_BRIEFCASE_WEB_URL=https://briefcase.teamofsilicons.com

# Notifications through Ting: off unless EXTEND_TING_URL is set (local = a development stand-in).
# EXTEND_TING_URL=https://backend.ting.teamofsilicons.com
# EXTEND_TING_MODE=off

# Bug reports (`extend report`). Required in production.
# EXTEND_POSTMARK_SERVER_TOKEN=
# EXTEND_REPORT_RECIPIENTS=bugs@teamofsilicons.com

# Links and the website.
# EXTEND_WEBSITE_URL=http://localhost:4220
# EXTEND_DOCS_URL=http://localhost:4220/docs
# EXTEND_CORS_ORIGINS=          # comma-separated origins allowed to call the API from a page directly
# EXTEND_TRUSTED_PROXY_CIDRS=   # proxies whose X-Forwarded-For Extend believes

# Optional limits and versioning (docs/operations.md).
# EXTEND_MAX_PAIRS_PER_DEVICE=8
# EXTEND_DEVICE_APP_MIN_VERSION=1.0.0
# EXTEND_DEPRECATED_API_VERSIONS=
# EXTEND_LOG=info,sqlx=warn,tower_http=info
# EXTEND_LOG_FORMAT=json
