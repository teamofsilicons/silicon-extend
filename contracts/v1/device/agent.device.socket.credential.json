{
  "api_version": 1,
  "consumer": "extend-agent",
  "consumer_version": "1.1.0",
  "contract": 1,
  "given": [
    "paired"
  ],
  "kind": "device_socket",
  "operation": "device.socket.credential",
  "os": "macos",
  "reads": {
    "credential": [
      "device_credential"
    ],
    "ping": [
      "nonce"
    ],
    "session_ended": [
      "session_id",
      "reason"
    ],
    "session_started": [
      "session_id",
      "silicon_id",
      "since",
      "side"
    ]
  },
  "request": {
    "headers": {
      "authorization": "Extend-Device {device_credential}",
      "silicon-extend-api-version": "1"
    },
    "method": "GET",
    "path": "/api/v1/device/connect"
  },
  "sends": [
    {
      "effect": "hello",
      "frame": {
        "app_version": "1.1.0",
        "capabilities": [
          "screen.read",
          "screen.capture",
          "screen.record",
          "input.pointer",
          "input.text",
          "input.keyboard",
          "apps.launch",
          "apps.list",
          "alerts",
          "clipboard",
          "logs",
          "takeover",
          "terminal"
        ],
        "engine_version": "0.21.15",
        "features": [
          "setup_retry"
        ],
        "missing": [],
        "model": "MacBookPro18,3",
        "os": "macos",
        "os_version": "15.5",
        "setup": {
          "state": "complete",
          "steps": []
        },
        "type": "hello"
      }
    },
    {
      "effect": "credential_saved",
      "frame": {
        "type": "credential_saved"
      }
    }
  ],
  "source": "docs/device-protocol.md (1.1); crates/extend-agent/src/agent.rs and service.rs (1.1) with crates/extend-protocol/src/frames.rs (ServiceFrame::Credential → credential.rs replace, then credential_saved)"
}
