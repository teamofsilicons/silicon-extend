{
  "api_version": 1,
  "consumer": "extend-agent",
  "consumer_version": "1.1.0",
  "contract": 1,
  "given": [
    "paired"
  ],
  "kind": "device_socket",
  "operation": "device.socket.setup_retry",
  "os": "macos",
  "reads": {
    "attach": [
      "device_id",
      "os",
      "name"
    ],
    "cancel": [
      "id"
    ],
    "command": [
      "id",
      "session_id",
      "command",
      "timeout_ms",
      "upload_ids"
    ],
    "environment": [],
    "ping": [
      "nonce"
    ],
    "refresh": [],
    "session_ended": [
      "session_id",
      "reason"
    ],
    "session_started": [
      "session_id",
      "silicon_id",
      "since"
    ],
    "setup_code": [
      "device_id",
      "code"
    ],
    "setup_retry": [
      "target",
      "step"
    ],
    "superseded": [],
    "takeover": [
      "session_id",
      "reason",
      "expires_at"
    ],
    "takeover_ended": [
      "session_id"
    ],
    "unpaired": [
      "reason"
    ]
  },
  "request": {
    "headers": {
      "authorization": "Extend-Device {device_credential}",
      "silicon-extend-api-version": "1"
    },
    "method": "GET",
    "path": "/api/v1/device/connect"
  },
  "sends": [
    {
      "effect": "hello",
      "frame": {
        "app_version": "1.1.0",
        "capabilities": [
          "screen.read",
          "screen.capture",
          "screen.record",
          "input.pointer",
          "input.text",
          "input.keyboard",
          "apps.launch",
          "apps.list",
          "alerts",
          "clipboard",
          "logs",
          "takeover",
          "terminal"
        ],
        "engine_version": "0.21.15",
        "features": [
          "setup_retry"
        ],
        "missing": [],
        "model": "MacBookPro18,3",
        "os": "macos",
        "os_version": "15.5",
        "setup": {
          "state": "complete",
          "steps": []
        },
        "type": "hello"
      }
    },
    {
      "effect": "attached",
      "frame": {
        "capabilities": [],
        "device_id": "{attached_id}",
        "missing": [],
        "model": "AppleTV14,1",
        "online": false,
        "os_version": "18.0",
        "setup": {
          "state": "needs_carbon",
          "steps": [
            {
              "error": "The Apple TV didn't answer. Turn it on and keep it on the same network as this Mac, then tap Retry.",
              "help": "Turn the Apple TV on and connect it to the same Wi-Fi or network as this Mac.",
              "key": "network",
              "status": "failed",
              "title": "The Apple TV is on and on the same network as this Mac"
            },
            {
              "key": "code",
              "status": "todo",
              "title": "Enter the code the Apple TV shows"
            }
          ]
        },
        "type": "attached"
      }
    },
    {
      "effect": "setup_retry",
      "frame": {
        "capabilities": [],
        "device_id": "{attached_id}",
        "missing": [],
        "model": "AppleTV14,1",
        "online": true,
        "os_version": "18.0",
        "setup": {
          "state": "needs_carbon",
          "steps": [
            {
              "key": "network",
              "status": "done",
              "title": "The Apple TV is on and on the same network as this Mac"
            },
            {
              "input": "code",
              "key": "code",
              "status": "needs_carbon",
              "title": "Enter the code the Apple TV shows"
            }
          ]
        },
        "type": "attached"
      }
    }
  ],
  "source": "docs/device-protocol.md (1.1); crates/extend-agent/src/agent.rs and service.rs (1.1) with crates/extend-protocol/src/frames.rs (SetupRetry with target → hosted.rs reruns the carried device's step)"
}
