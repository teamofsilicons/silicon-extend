      "content-type": "application/json",
      "idempotency-key": "{idempotency_key}",
      "silicon-extend-api-version": "1"
    },
    "method": "POST",
    "path": "/api/v1/auth/logout"
  },
  "response": {
    "non_null": [],
    "required": [],
    "status": "2xx",
    "type": "logout"
  }
}
