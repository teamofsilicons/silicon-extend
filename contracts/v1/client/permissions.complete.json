{
  "api_version": 1,
  "call": "Authed::complete_permissions",
  "consumer": "silicon-extend-client",
  "consumer_version": "2.0.0",
  "contract": 1,
  "given": [
    "permission_request"
  ],
  "operation": "permissions.complete",
  "request": {
    "body": {
      "data": {
        "code": "{permission_code}"
      },
      "type": "permission"
    },
    "headers": {
      "authorization": "Bearer {carbon_token}",
      "content-type": "application/json",
      "idempotency-key": "{idempotency_key}",
      "silicon-extend-api-version": "1",
      "x-org-id": "{team}"
    },
    "method": "POST",
    "path": "/api/v1/permissions/{permission_id}/complete"
  },
  "response": {
    "non_null": [
      "/items",
      "/items/*/audience",
      "/items/*/endpoint_id",
      "/items/*/expires_at",
      "/items/*/grant_id",
      "/items/*/org_id"
    ],
    "required": [
      "/items",
      "/items/*/actor",
      "/items/*/audience",
      "/items/*/endpoint_id",
      "/items/*/expires_at",
      "/items/*/grant_id",
      "/items/*/org_id"
    ],
    "status": "2xx",
    "type": "permissions"
  }
}
