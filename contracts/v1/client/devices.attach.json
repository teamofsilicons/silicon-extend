{
  "api_version": 1,
  "call": "Authed::attach",
  "consumer": "silicon-extend-client",
  "consumer_version": "1.0.0",
  "contract": 1,
  "given": [
    "host"
  ],
  "operation": "devices.attach",
  "request": {
    "body": {
      "data": {
        "address": "192.168.1.20",
        "name": "Living room",
        "os": "tvos",
        "pair_ttl_days": 7,
        "visibility": "team"
      },
      "type": "attachment"
    },
    "headers": {
      "authorization": "Bearer {carbon_token}",
      "content-type": "application/json",
      "idempotency-key": "{idempotency_key}",
      "silicon-extend-api-version": "1",
      "x-org-id": "{team}"
    },
    "method": "POST",
    "path": "/api/v1/devices/{host_id}/attachments"
  },
  "response": {
    "non_null": [
      "/device_id",
      "/in_use/paused",
      "/in_use/session_id",
      "/in_use/silicon_id",
      "/in_use/since",
      "/kind",
      "/missing/*/capability",
      "/missing/*/reason",
      "/name",
      "/online",
      "/os",
      "/owner",
      "/owner/id",
      "/owner/type",
      "/state",
      "/visibility"
    ],
    "required": [
      "/device_id",
      "/in_use/session_id",
      "/in_use/silicon_id",
      "/in_use/since",
      "/kind",
      "/missing/*/capability",
      "/missing/*/reason",
      "/name",
      "/online",
      "/os",
      "/owner",
      "/owner/id",
      "/owner/type",
      "/state",
      "/visibility"
    ],
    "status": "2xx",
    "type": "device"
  }
}
