{
  "api_version": 1,
  "call": "Authed::device",
  "consumer": "silicon-extend-client",
  "consumer_version": "1.0.0",
  "contract": 1,
  "given": [
    "device"
  ],
  "operation": "devices.get",
  "request": {
    "body": null,
    "headers": {
      "authorization": "Bearer {carbon_token}",
      "silicon-extend-api-version": "1",
      "x-org-id": "{team}"
    },
    "method": "GET",
    "path": "/api/v1/devices/{device_id}"
  },
  "response": {
    "non_null": [
      "/device_id",
      "/in_use/paused",
      "/in_use/session_id",
      "/in_use/silicon_id",
      "/in_use/since",
      "/kind",
      "/missing/*/capability",
      "/missing/*/reason",
      "/name",
      "/online",
      "/os",
      "/owner",
      "/owner/id",
      "/owner/type",
      "/state",
      "/visibility"
    ],
    "required": [
      "/device_id",
      "/in_use/session_id",
      "/in_use/silicon_id",
      "/in_use/since",
      "/kind",
      "/missing/*/capability",
      "/missing/*/reason",
      "/name",
      "/online",
      "/os",
      "/owner",
      "/owner/id",
      "/owner/type",
      "/state",
      "/visibility"
    ],
    "status": "2xx",
    "type": "device"
  }
}
